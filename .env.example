# Keycloak-only stack environment template
# Copy this file to .env in keycloak-stack directory.

# Public URL used by browser and token issuer
# Production (Coolify): https://sso-ng.iom-itb.id
#   -> issuer: https://sso-ng.iom-itb.id/realms/iom-itb-sso
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Realm imported from keycloak/realm-export.json
REALM=iom-itb-sso

# Keycloak bootstrap admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=keycloak

# Optional: set explicitly in production
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=true

# Client BanKes-OTA-NG & iom-itb-api-NG (placeholder di keycloak/realm-export.json)
# Base URL Bankes; client OTA-KU memakai <BANKES_PUBLIC_URL>/ota
BANKES_PUBLIC_URL=https://bankes.iom-itb.id
# Buat dengan: openssl rand -hex 32
# Nilai harus sama dengan env di aplikasi masing-masing:
#   BANKES_KEYCLOAK_CLIENT_SECRET    -> BanKes-OTA-NG BANKES_KEYCLOAK_CLIENT_SECRET
#   OTA_KEYCLOAK_CLIENT_SECRET       -> BanKes-OTA-NG KEYCLOAK_CLIENT_SECRET
#   API_ADMIN_KEYCLOAK_CLIENT_SECRET -> iom-itb-api-NG KEYCLOAK_ADMIN_CLIENT_SECRET
BANKES_KEYCLOAK_CLIENT_SECRET=
OTA_KEYCLOAK_CLIENT_SECRET=
API_ADMIN_KEYCLOAK_CLIENT_SECRET=
