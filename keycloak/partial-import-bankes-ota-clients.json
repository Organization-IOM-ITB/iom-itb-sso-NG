      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "rootUrl": "https://bankes.iom-itb.id/ota",
      "baseUrl": "https://bankes.iom-itb.id/ota",
      "redirectUris": [
        "https://bankes.iom-itb.id/ota/integrations/keycloak/callback*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://bankes.iom-itb.id/ota/auth/login",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      }
    },
    {
      "clientId": "iom-itb-api-admin",
