      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "rootUrl": "https://bankes.iom-itb.id",
      "baseUrl": "https://bankes.iom-itb.id",
      "redirectUris": [
        "https://bankes.iom-itb.id/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://bankes.iom-itb.id/login##https://bankes.iom-itb.id/ota/auth/login",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      }
    },
    {
      "clientId": "ota-ku-app",
      "name": "OTA-KU",
